APP_NAME="Syrian Zone"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost

FRONTEND_URL=http://localhost:3000

APP_LOCALE=ar
APP_FALLBACK_LOCALE=ar
APP_FAKER_LOCALE=ar_SA

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# previous APP_KEY values, comma-separated, still accepted while old encrypted
# cookies and sessions are read (key rotation: `php artisan key:rotate`).
# APP_PREVIOUS_KEYS=
# URL prefix of the JSON API (/api by default). The browser clients and the
# service worker hard-code the default paths, so change it only with them.
# API_PREFIX=

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Secure session cookie: on by default when APP_ENV=production, off for local
# plain-http. Set it explicitly only to override that.
# SESSION_SECURE_COOKIE=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# reverb websockets: comma-separated hosts allowed to connect, matched against
# the Origin header's host only (bare hosts, "*.example.com" works — not urls).
# empty = this app's own APP_URL host, which covers the web client only.
# production must set this explicitly.
REVERB_ALLOWED_ORIGINS=
# the app id/key/secret shared by the reverb server and the browser client.
# REVERB_APP_ID=
# REVERB_APP_KEY=
# REVERB_APP_SECRET=
# public host, port and scheme the browser connects to (usually via nginx).
# REVERB_HOST=
# REVERB_PORT=
# REVERB_SCHEME=
# bind address and port of the reverb server process itself.
# REVERB_SERVER_HOST=
# REVERB_SERVER_PORT=
# the same connection, exposed to the vite bundle (echo reads these).
# VITE_REVERB_HOST=
# VITE_REVERB_PORT=
# VITE_REVERB_SCHEME=

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# media storage: "public" (local dev/tests) or "r2" (production, Cloudflare R2)
MEDIA_DISK=public
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=syrianzone-media
# https://<account-id>.r2.cloudflarestorage.com
R2_ENDPOINT=https://d9fdae5f330dc2177f98aecf7725ce71.r2.cloudflarestorage.com
# public base url serving the bucket (custom domain or CDN pull zone), no trailing slash
# this host MUST send Access-Control-Allow-Origin for the app origin (bucket CORS
# policy or CDN rule, GET/HEAD): the lightbox downloads fetch() these urls cross-origin
R2_URL=https://pub-1d51b625c56e4fd085c58a79672e1b15.r2.dev

# offsite db backups: PRIVATE bucket (never the public media bucket); empty = local backups only.
# needs its own token: the media token is bucket-scoped and cannot write here
R2_BACKUP_BUCKET=
R2_BACKUP_ACCESS_KEY_ID=
R2_BACKUP_SECRET_ACCESS_KEY=
# password of the encrypted backup archive; empty = the archive is not encrypted.
# BACKUP_ARCHIVE_PASSWORD=
# discord webhook that receives backup success/failure notifications.
# DISCORD_BACKUP_WEBHOOK=

# sentry error tracking; empty = disabled. frontend dsn (VITE_SENTRY_DSN) and the
# sourcemap upload token are injected by ci at image build time, not from this file
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0
# ship laravel logs to sentry logs (needs the sentry_logs channel in LOG_STACK)
SENTRY_ENABLE_LOGS=false
SENTRY_LOGS_LEVEL=info

# content-security-policy, report-only: the browser reports violations but
# blocks nothing, so the policy is observable before it is enforced. set to
# false to stop sending the header (no code deploy needed); never becomes an
# enforcing header yet. see config/security.php.
CSP_REPORT_ONLY=true
# where the browser posts violations. empty = no reporting endpoint, and the
# header is still sent. sentry can host one: sentry's "security header
# reporting" endpoint accepts CSP reports at
# https://<org>.ingest.sentry.io/api/<project>/security/?sentry_key=<key>
CSP_REPORT_URI=

# tierlist announcements on X; disabled until target-account OAuth tokens exist
X_TIERLIST_ENABLED=false
X_TIERLIST_POLL_SLUG=best-ministers
X_TIERLIST_SETTLE_MINUTES=15
X_TIERLIST_MIN_POST_INTERVAL_MINUTES=720
X_TIERLIST_DAILY_POST_LIMIT=2
X_API_BASE_URL=https://api.x.com
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=
X_EXPECTED_USER_ID=

VITE_APP_NAME="${APP_NAME}"

# MP3Quran v4 API base (Quran recitations, timings and radio). Staging until v4
# reaches production; override to https://api.mp3quran.net when it ships.
VITE_MP3QURAN_API=https://api-staging.mp3quran.net

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=
SUPERADMIN_EMAIL=

# server-side key for the mishwar search suggestions (Places API New, text search)
GOOGLE_PLACES_API_KEY=

OPENWEATHER_API_KEY=
# endpoint the weather proxy calls (leave empty for the openweather default).
# OPENWEATHER_API_URL=

# upstream services the API proxies: answers.syrian.zone (community Q&A),
# food.syrian.zone (recipe of the day), the F3alia events GraphQL endpoint and
# api.aladhan.com (prayer times). Empty = the production defaults.
# ANSWERS_API_URL=
# RECIPES_BASE_URL=
# EVENTS_GRAPHQL_URL=
# PRAYER_API_URL=

# extra Google OAuth client ids (web/android/ios) accepted as the audience of a
# native id_token; empty = only GOOGLE_CLIENT_ID is accepted.
# GOOGLE_ALLOWED_CLIENT_IDS=

# bearer token guarding /api/metrics; empty = anyone may scrape it.
# METRICS_TOKEN=

# google analytics measurement id. blank = the gtag snippet is not rendered at
# all, which is how staging and local opt out. production must have this set.
GA_MEASUREMENT_ID=

# logs every visitor in as a superadmin and enables /dev/impersonate/{role}.
# ignored when APP_ENV=production. never enable on a host without an auth gate.
AUTO_LOGIN_DEV=false

# MCP / agent API access (/mcp/*). Leave MCP_ENABLED=false to keep the surface
# closed everywhere and opt in per environment.
MCP_ENABLED=false
# write every MCP tool call to the audit table (arguments are redacted).
# MCP_AUDIT_ENABLED=

# HalaSyria hotel data API key (Supabase anon key, public read-only)
HALASYRIA_API=

# Inertia SSR is ON by default (see config/inertia.php). Set to false to disable
# it and fall back to client-side rendering + the server-rendered PHP meta.
# INERTIA_SSR_ENABLED=true

# sanctum stateful session cookies: comma-separated hosts that receive them
# (the web app's own host). empty = sanctum's own default.
# SANCTUM_STATEFUL_DOMAINS=
# minutes a sanctum token stays valid; empty = tokens never expire.
# SANCTUM_EXPIRATION=

# SEO: the canonical host absolute urls are built against (defaults to
# resources/data/site.json), and the twitter:site handle. empty = no tag.
# SEO_BASE_URL=
# SEO_TWITTER_SITE=

# share-card renderer (scripts/og): node binary on the php process's path, the
# seconds one drawing may take, and extra comma-separated hosts a record card
# may fetch a photo from beyond this site's own media hosts.
# OG_NODE_BINARY=
# OG_RENDER_TIMEOUT=
# OG_IMAGE_HOSTS=
