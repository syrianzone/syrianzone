{
  "name": "@syrianzone/ios",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "overrides": {
    "minimatch": "11.0.8"
  },
  "scripts": {
    "start": "expo start --dev-client",
    "ios": "node scripts/simulator.mjs",
    "ios:prepare": "node scripts/simulator.mjs --prepare",
    "ios:smoke": "node scripts/smoke-ios.mjs",
    "ios:release": "expo run:ios --configuration Release --no-bundler",
    "prebuild": "expo prebuild --platform ios",
    "check": "bun run typecheck && bun run lint && bun run test",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "benchmark": "bun run scripts/benchmark.ts",
    "test": "bun test ./src ./scripts ./native-tests"
  },
  "dependencies": {
    "@expo/ui": "58.0.28",
    "@pusher/pusher-websocket-react-native": "1.3.6",
    "@react-navigation/bottom-tabs": "7.21.0",
    "@react-navigation/native": "7.5.1",
    "@react-navigation/native-stack": "7.21.0",
    "expo": "58.0.25",
    "expo-build-properties": "58.0.12",
    "expo-clipboard": "58.0.4",
    "expo-crypto": "58.0.8",
    "expo-dev-client": "58.0.20",
    "expo-document-picker": "58.0.5",
    "expo-file-system": "58.0.13",
    "expo-font": "58.0.12",
    "expo-image": "58.0.18",
    "expo-image-picker": "58.0.10",
    "expo-linking": "58.0.17",
    "expo-localization": "58.0.5",
    "expo-location": "58.0.22",
    "expo-maps": "58.0.11",
    "expo-secure-store": "58.0.3",
    "expo-sharing": "58.0.23",
    "expo-sqlite": "58.0.17",
    "expo-symbols": "58.0.5",
    "expo-web-browser": "58.0.8",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "5.11.1",
    "react-native-screens": "4.30.1",
    "react-native-svg": "15.16.0",
    "supercluster": "8.0.1"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@types/bun": "1.3.11",
    "@types/react": "19.3.0",
    "@types/react-test-renderer": "19.3.1",
    "@types/supercluster": "7.1.3",
    "babel-preset-expo": "58.0.24",
    "eslint": "10.15.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "react-test-renderer": "19.3.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0"
  },
  "patchedDependencies": {
    "react-native-svg@15.16.0": "patches/react-native-svg@15.16.0.patch",
    "@pusher/pusher-websocket-react-native@1.3.6": "patches/@pusher%2Fpusher-websocket-react-native@1.3.6.patch",
    "expo-modules-core@58.1.0": "patches/expo-modules-core@58.1.0.patch",
    "react-native@0.88.1": "patches/react-native@0.88.1.patch"
  },
  "expo": {
    "autolinking": {
      "ios": {
        "buildFromSource": ["ExpoModulesCore", "ExpoModulesWorklets"]
      }
    }
  }
}
