{
  "name": "@syrianzone/ios",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "overrides": {
    "minimatch": "11.0.8"
  },
  "scripts": {
    "start": "expo start --dev-client",
    "ios": "node scripts/simulator.mjs",
    "ios:prepare": "node scripts/simulator.mjs --prepare",
    "ios:smoke": "node scripts/smoke-ios.mjs",
    "ios:release": "expo run:ios --configuration Release --no-bundler",
    "prebuild": "expo prebuild --platform ios",
    "check": "bun run typecheck && bun run lint && bun test",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "benchmark": "bun run scripts/benchmark.ts",
    "test": "bun test"
  },
  "dependencies": {
    "@expo/ui": "58.0.28",
    "@react-navigation/bottom-tabs": "7.21.0",
    "@react-navigation/native": "7.5.1",
    "@react-navigation/native-stack": "7.21.0",
    "expo": "58.0.25",
    "expo-build-properties": "58.0.12",
    "expo-dev-client": "58.0.20",
    "expo-image": "58.0.18",
    "expo-linking": "58.0.17",
    "expo-localization": "58.0.5",
    "expo-location": "58.0.22",
    "expo-maps": "58.0.11",
    "expo-sqlite": "58.0.17",
    "expo-symbols": "58.0.5",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "5.11.1",
    "react-native-screens": "4.30.1"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@types/bun": "1.3.11",
    "@types/react": "19.3.0",
    "babel-preset-expo": "58.0.24",
    "eslint": "10.15.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0"
  }
}
