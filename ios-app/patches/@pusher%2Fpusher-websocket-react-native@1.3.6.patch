 }
+
+// Keep this Foundation-only validator in the existing Pod source target.
+enum PusherOrigin {
+  static func validated(_ value: Any) -> String? {
+    guard let origin = value as? String, origin.utf8.count <= 2048,
+      origin.utf8.allSatisfy({ $0 > 0x20 && $0 < 0x7f }),
+      let parts = URLComponents(string: origin), parts.scheme == "https",
+      parts.user == nil, parts.password == nil, parts.path.isEmpty,
+      parts.query == nil, parts.fragment == nil,
+      let host = parts.host, !host.isEmpty else { return nil }
+    if let port = parts.port, !(1...65535).contains(port) { return nil }
+    var canonical = URLComponents()
+    canonical.scheme = "https"
+    canonical.host = host.lowercased()
+    canonical.port = parts.port == 443 ? nil : parts.port
+    guard canonical.string == origin else { return nil }
+    return origin
+  }
+}
