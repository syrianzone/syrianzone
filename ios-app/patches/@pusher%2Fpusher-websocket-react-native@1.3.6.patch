+        if let origin {
+            let connection = PusherWebsocketReactNative.pusher.connection
+            let webSocketOptions = NWWebSocket.defaultOptions
+            webSocketOptions.setSubprotocols(["pusher-channels-protocol-7"])
+            webSocketOptions.setAdditionalHeaders([("Origin", origin)])
+            // Pusher already constructed its original socket from this same URL.
+            let socket = NWWebSocket(url: URL(string: connection.url)!, options: webSocketOptions)
+            socket.delegate = connection
+            connection.socket = socket
