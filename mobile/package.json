    "jest-expo": "~57.0.2",
    "react-test-renderer": "19.2.3",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start --dev-client",
    "start:clear": "expo start --dev-client --clear",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint --max-warnings 0",
    "postinstall": "node scripts/patch-maplibre-ios-logging.mjs && node scripts/patch-maplibre-ios-source-recycling.mjs",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:ci": "jest --runInBand --coverage",
    "test:tooling": "node --test scripts/verify-release-toolchain.test.mjs scripts/patch-maplibre-ios-logging.test.mjs scripts/patch-maplibre-ios-source-recycling.test.mjs plugins/withDataChannelWebRtc.test.js",
    "verify:port": "node scripts/verify-port-contract.mjs",
    "doctor": "npx expo-doctor@latest",
    "export": "expo export --platform all",
    "prebuild:clean": "EXPO_NO_GIT_STATUS=1 expo prebuild --clean",
    "build:ios": "node scripts/run-release.mjs ios",
    "build:android": "node scripts/run-release.mjs android",
    "smoke:ios": "node scripts/run-maestro.mjs ios",
    "smoke:android": "node scripts/run-maestro.mjs android"
  },
  "overrides": {
    "uuid": "11.1.1"
  },
  "private": true,
  "engines": {
    "node": "^22.13.0 || ^24.0.0"
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "react-native-webrtc"
        ]
      }
    }
  }
