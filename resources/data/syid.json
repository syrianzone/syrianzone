    "symbolism": [
      {
        "id": "historical-roots",
        "title_ar": "الاستمرارية التاريخية والعقاب الذهبي",
        "body_ar": "أُطلقت الهوية البصرية الجديدة في 3 تموز 2025 في قصر الشعب بدمشق متخذةً «العقاب الذهبي السوري» شعاراً رسمياً للدولة، امتداداً لما صمّمه الفنان التشكيلي السوري خالد العسلي عام 1945، واستحضاراً لرمزية العقاب في الحضارات السورية القديمة وتاريخ فتح الشام في معركة ثنية العقاب؛ فيما يرمز اللون الذهبي إلى السمو والرفعة.",
        "source_label_ar": "سانا — حكاية الهوية البصرية الجديدة (3 تموز 2025)",
        "source_url": "https://sana.sy/locals/2242953/"
      },
      {
        "id": "three-stars",
        "title_ar": "تحرّر النجوم الثلاث فوق العقاب",
        "body_ar": "تختصر النجوم الثلاث العلم السوري شكلاً والشعب السوري مضموناً. وبعد أن كانت محصورة داخل صدر الشعار السابق، تحرّرت لتعتلي رأس العقاب وتحيط به، في دلالة رسمية على أن الشعب يعلو السلطة وأن الدولة منبثقة منه وخادمة له، مع تحرير العقاب من الترس القتالي لتجسيد مفهوم «الدولة الحارسة».",
        "source_label_ar": "سانا — حكاية الهوية البصرية الجديدة (3 تموز 2025)",
        "source_url": "https://sana.sy/locals/2242953/"
      },
      {
        "id": "wing-feathers",
        "title_ar": "14 ريشة في الجناحين (المحافظات الأربع عشرة)",
        "body_ar": "يتكوّن كل جناح من سبع ريشات متناظرة ليصبح المجموع 14 ريشة تمثل المحافظات السورية الأربع عشرة في حالة اتزان واستعداد لا عدوان، ما يؤكد وحدة الأراضي السورية وتكامل جميع محافظاتها في استقرار الدولة.",
        "source_label_ar": "سانا — كيف صُمّم شعار سوريا الجديد وما هي دلالاته؟ (5 تموز 2025)",
        "source_url": "https://sana.sy/locals/2243648/"
      },
      {
        "id": "tail-feathers",
        "title_ar": "5 ريشات في الذيل (المناطق الجغرافية الخمس)",
        "body_ar": "ينسدل ذيل العقاب بخمس ريشات تمثل المناطق الجغرافية الكبرى في سوريا: الشمالية، الشرقية، الغربية، الجنوبية، والوسطى، تعبيراً عن وحدة الأرض والهوية والتكامل بينها دون تفاضل أو إقصاء.",
        "source_label_ar": "سانا — حكاية الهوية البصرية الجديدة (3 تموز 2025)",
        "source_url": "https://sana.sy/locals/2242953/"
      },
      {
        "id": "head-direction",
        "title_ar": "اتجاه الرأس والتطلّع إلى المستقبل",
        "body_ar": "أوضح مدير فريق تطوير الهوية البصرية وسيم قدورة لوكالة سانا أن توجيه رأس العقاب نحو يمين الشعار جاء للدلالة على التطلّع إلى المستقبل والتطوّر، بعد أن كان الشعار القديم يوجّه الرأس إلى الجهة المقابلة، مشيراً إلى أن المشروع أنجزه فريق من 40 مختصاً سورياً في أكثر من 30 دولة بعد بحث تاريخي واستبيان شارك فيه آلاف السوريين.",
        "source_label_ar": "سانا — كيف صُمّم شعار سوريا الجديد وما هي دلالاته؟ (5 تموز 2025)",
        "source_url": "https://sana.sy/locals/2243648/"
      }
    ],
